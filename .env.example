# Vercel build-time public API URL. Do not add API keys here.
VITE_API_BASE=http://localhost:3001/api

# Optional provider keys for the local Compose stack. Leave blank to use the
# deterministic safety-policy fallback and template explanation.
NVIDIA_API_KEY=nvapi-your-nvidia-key
NVIDIA_MODEL=openai/gpt-oss-120b
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_CONFIDENCE_THRESHOLD=0.75
